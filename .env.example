# Database Connection String
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/hospital_db?schema=public"

# Authentication Secret (Used by NextAuth/Auth.js)
# You can generate one by running `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="your_generated_secret_here"

# Storage Keys (For Gallery Uploads)
# Replace with your actual S3 / R2 / Cloud Storage credentials
STORAGE_ACCESS_KEY="your_storage_access_key"
STORAGE_SECRET_KEY="your_storage_secret_key"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET_NAME="hospital-gallery-bucket"

# Maps/Geolocation
# Replace with your Google Maps or Mapbox API key
MAPS_API_KEY="your_maps_api_key_here"
